{
  "name": "@baizor/pipeline",
  "version": "0.21.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanMurzak/pipeline.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plan": "./src/lib/plan.ts"
  },
  "bin": {
    "pipeline": "src/cli.ts"
  },
  "description": "Unified local CLI for the Claude-Pipeline plugin: deterministic planning (and, in later phases, matching / routing / event emission / UI) computed OUTSIDE the LLM context so agents pay near-zero tokens for control-flow work. Runs directly with Bun; a Node-targeted bundle can be produced for embedding in other local projects.",
  "engines": {
    "bun": ">=1.3.14"
  },
  "homepage": "https://ai-pipeline.dev",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "test": "bun scripts/parallel-tests.ts tests",
    "test:seq": "bun test tests/",
    "build": "bun build src/cli.ts --target=node --format=esm --outfile=dist/cli.mjs"
  },
  "type": "module",
  "dependencies": {
    "@baizor/pipeline-protocol": "0.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.228"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
